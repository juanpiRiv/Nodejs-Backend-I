<link rel="stylesheet" href="/css/styles.css">

<h1>Lista de Productos</h1>

<a href="/cart"><button>🛒 Ver Carrito</button></a>

<!-- FORMULARIO DE FILTROS -->
<form method="GET" action="/products">
    <label for="search">Buscar:</label>
    <input type="text" name="search" id="search" value="{{search}}">

    <label for="category">Categoría:</label>
    <select name="category" id="category">
        <option value="" {{#if (eq category "")}}selected{{/if}}>Todas</option>
        <option value="Almacenamiento" {{#if (eq category "Almacenamiento")}}selected{{/if}}>Almacenamiento</option>
        <option value="Accesorios" {{#if (eq category "Accesorios")}}selected{{/if}}>Accesorios</option>
        <option value="Tecnología" {{#if (eq category "Tecnología")}}selected{{/if}}>Tecnología</option>
        <option value="Muebles" {{#if (eq category "Muebles")}}selected{{/if}}>Muebles</option>
        <option value="Telefonía" {{#if (eq category "Telefonía")}}selected{{/if}}>Telefonía</option>
        <option value="Audio" {{#if (eq category "Audio")}}selected{{/if}}>Audio</option>
        <option value="Hardware" {{#if (eq category "Hardware")}}selected{{/if}}>Hardware</option>
        <option value="Oficina" {{#if (eq category "Oficina")}}selected{{/if}}>Oficina</option>
        <option value="Redes" {{#if (eq category "Redes")}}selected{{/if}}>Redes</option>
    </select>

    <label for="sort">Ordenar por precio:</label>
    <select name="sort" id="sort">
        <option value="" {{#if (eq sort "")}}selected{{/if}}>Sin orden</option>
        <option value="asc" {{#if (eq sort "asc")}}selected{{/if}}>Menor a mayor</option>
        <option value="desc" {{#if (eq sort "desc")}}selected{{/if}}>Mayor a menor</option>
    </select>

    <label for="limit">Productos por página:</label>
    <input type="number" name="limit" id="limit" value="{{limit}}" min="1">

    <button type="submit">Filtrar</button>
</form>

<!-- TABLA DE PRODUCTOS -->
<table border="1">
    <tr>
        <th>Imagen</th>
        <th>Nombre</th>
        <th>Precio</th>
        <th>Categoría</th>
        <th>Acciones</th>
    </tr>
    {{#each payload}}
    <tr>
        <td>
            <a href="/products/{{this._id}}">
                <img src="{{this.thumbnails.[0]}}" width="50">
            </a>
        </td>
        <td>
            <a href="/products/{{this._id}}" class="product-link">
                {{this.title}}
            </a>
        </td>
        <td>${{this.price}}</td>
        <td>{{this.category}}</td>
        <td>
            <!-- Quitar el form. Usar data attributes y clases para JS -->
            <input type="number" class="product-quantity" value="1" min="1" style="width: 50px; margin-right: 5px;">
            <button class="add-to-cart-btn" data-product-id="{{this._id}}">Agregar al Carrito</button>
        </td>
    </tr>
    {{/each}}
</table>

<!-- PAGINACIÓN -->
<div>
    {{#if hasPrevPage}}
    <a href="?page={{prevPage}}&limit={{limit}}&sort={{sort}}&query={{query}}">⬅ Página Anterior</a>
    {{/if}}
    <span>Página {{page}} de {{totalPages}}</span>
    {{#if hasNextPage}}
    <a href="?page={{nextPage}}&limit={{limit}}&sort={{sort}}&query={{query}}">Página Siguiente ➡</a>
    {{/if}}
</div>

<!-- Script para manejar la adición asíncrona al carrito -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');

        addToCartButtons.forEach(button => {
            button.addEventListener('click', async (event) => {
                event.preventDefault(); // Evitar cualquier comportamiento por defecto

                const productId = button.dataset.productId;
                // Encontrar el input de cantidad asociado (asumiendo que es el elemento hermano anterior)
                const quantityInput = button.previousElementSibling;
                const quantity = quantityInput ? parseInt(quantityInput.value) : 1;

                if (isNaN(quantity) || quantity < 1) {
                    alert('Por favor, introduce una cantidad válida.');
                    return;
                }

                console.log(`Agregando producto ${productId}, cantidad ${quantity}`);

                try {
                    const response = await fetch('/api/carts/add-product', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ productId, quantity }),
                    });

                    const result = await response.json();
                    const originalButtonText = button.textContent; // Guardar texto original

                    if (response.ok && result.status === 'success') {
                        console.log(`Producto agregado al carrito! (Carrito ID: ${result.cartId})`);
                        // Cambiar texto del botón temporalmente para feedback visual
                        button.textContent = '✅ Agregado!';
                        button.disabled = true; // Deshabilitar temporalmente
                        setTimeout(() => {
                            button.textContent = originalButtonText;
                            button.disabled = false;
                        }, 2000); // Volver al estado original después de 2 segundos

                        // Opcional: actualizar un contador de carrito en la UI, etc.
                    } else {
                         console.error(`Error al agregar producto: ${result.message || 'Respuesta no exitosa de la API'}`);
                         // Cambiar texto del botón temporalmente para feedback de error
                         button.textContent = '❌ Error';
                         button.disabled = true;
                         setTimeout(() => {
                            button.textContent = originalButtonText;
                            button.disabled = false;
                         }, 2500);
                    }
                } catch (error) {
                    console.error('Error en fetch al agregar producto:', error);
                     // Cambiar texto del botón temporalmente para feedback de error de red
                     const originalButtonText = button.textContent;
                     button.textContent = '❌ Error Red';
                     button.disabled = true;
                     setTimeout(() => {
                        button.textContent = originalButtonText;
                        button.disabled = false;
                     }, 2500);
                }
            });
        });
    });
</script>
